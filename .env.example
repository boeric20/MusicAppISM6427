# Copy to .env for local development with `netlify dev`.
# On Netlify, set these under Site configuration > Environment variables.

# Required. Your sunoapi.org API key. Never commit the real value.
SUNO_API_KEY=

# Optional. Shared access code visitors must enter before the app will spend credits.
# Leave blank to allow anyone who can reach the site to generate music.
APP_ACCESS_CODE=

# Optional. Override the callback URL sent to Suno. Defaults to <site origin>/api/callback.
SUNO_CALLBACK_URL=

# Optional. Override the Suno API base URL. Defaults to https://api.sunoapi.org
SUNO_API_BASE=
